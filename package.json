{
  "name": "coingram-chat",
  "private": true,
  "version": "1.20.57",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "test": "node testE2EE.js && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test --test-concurrency=4 tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:desktop": "npm run build && playwright test --config playwright.electron.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "release:verify": "node scripts/verify-release-version.mjs",
    "clean:artifacts": "node scripts/clean-artifacts.mjs",
    "clean:all": "node scripts/clean-artifacts.mjs --all",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "node scripts/deploy-pages.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --publish never",
    "electron:verify-fuses": "node scripts/verify-electron-fuses.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@supabase/supabase-js": "2.112.2",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "gh-pages": "6.3.0",
    "oxlint": "1.77.0",
    "supabase": "2.113.0",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  },
  "overrides": {
    "@xmldom/xmldom@0.8": "0.8.15",
    "@xmldom/xmldom@0.9": "0.9.12",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9",
    "fast-uri@3": "3.1.7",
    "js-yaml@4": "4.3.1",
    "nanoid@3": "3.3.18",
    "postcss@8": "8.5.23",
    "tar@7": "7.5.21",
    "undici@6": "6.28.0",
    "undici@7": "7.29.0",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.coingram.chat",
    "productName": "Coiny",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "afterPack": "scripts/apply-electron-fuses.cjs",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Coiny"
    }
  }
}
