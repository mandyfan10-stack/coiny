# Configure both variables to use a real Supabase project.
# With neither variable set, Coiny starts in local Mock Mode.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional Tenor GIF search. Use the same value in the GitHub release secret.
VITE_TENOR_API_KEY=

# Optional release update source.
VITE_GITHUB_REPO=mandyfan10-stack/coingram-chat

# E2EE v2 remains off until the pinned OpenMLS wrapper, matching WASM hash,
# test vectors and independent audit are present. These are build-time gates.
VITE_E2EE_V2_ENABLED=false
VITE_E2EE_V2_AUDIT_APPROVED=false
# OPENMLS_WASM_SHA256=
# E2EE_V2_AUDIT_REPORT_SHA256=
